{
  "name": "project-nullrise",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "packages": {
        "$className": "Folder",

        "_Index": {
          "$path": "Packages/_Index"
        },

        "Trove": {
          "$path": "Packages/Trove.lua"
        },

        "Signal": {
          "$path": "src/packages/Signal.lua"
        },

        "ShapecastHitbox": {
          "$path": "src/packages/ShapecastHitbox"
        }
      },

      "shared": {
        "$className": "Folder",
        "$path": "src/shared"
      },

      "ui": {
        "$className": "Folder"
      },

      "remotes": {
        "$className": "Folder",
        "$properties": {
          "Sandboxed": true
        },

        "Combat": {
          "$className": "RemoteEvent"
        },

        "Weapon": {
          "$className": "RemoteEvent"
        },

        "Inventory": {
          "$className": "RemoteEvent"
        },

        "CombatFx": {
          "$className": "UnreliableRemoteEvent"
        }
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",

      "weapon_models": {
        "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",

      "server": {
        "$path": "src/server"
      }
    },

    "TestService": {
      "$className": "TestService",
      "$path": "tests",

      "_Index": {
        "$path": "DevPackages/_Index"
      },

      "TestEZ": {
        "$path": "DevPackages/TestEZ.lua"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",

        "client": {
          "$path": "src/client"
        }
      }
    }
  }
}
